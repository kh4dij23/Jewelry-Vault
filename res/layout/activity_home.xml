<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center"
    android:background="#FCE4EC">

    <TextView
        android:id="@+id/welcomeText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Welcome to Jewelry Vault 💍"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#6A1B9A"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Manage your precious jewelry collection"
        android:textSize="14sp"
        android:textColor="#9C27B0"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/addBtn"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="➕ Add Jewelry Item"
        android:backgroundTint="#BA68C8"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"
        android:elevation="4dp" />

    <Button
        android:id="@+id/viewBtn"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="👑 View My Collection"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#9575CD"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:elevation="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Your precious memories, securely stored"
        android:textSize="12sp"
        android:textColor="#757575"
        android:layout_marginTop="32dp"
        android:textStyle="italic" />
</LinearLayout>